    "@nestjs/config": "^3.2.3",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "@clickhouse/client": "^1.5.0"
