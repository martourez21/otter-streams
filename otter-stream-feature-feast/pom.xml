        <artifactId>otter-streams</artifactId>
        <version>0.0.4</version>
    </parent>
    <artifactId>otter-stream-feature-feast</artifactId>
    <packaging>jar</packaging>
    <name>otter-stream-feature-feast</name>
    <description>Feast-backed FeatureProvider implementation for Otter Stream. Talks to a Feast
        HTTP feature server's online-serving endpoint over REST (not the gRPC serving API).</description>
    <url>http://maven.apache.org</url>

    <dependencies>
        <dependency>
            <groupId>com.codedstreams</groupId>
            <artifactId>ml-inference-core</artifactId>
        </dependency>

        <!-- HTTP client for the Feast HTTP feature server -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- JSON request/response handling -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
